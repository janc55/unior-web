---
/* === COMPONENTE: PooCountdown (AlpineJS) === */
---

<section
    id="countdown"
    class="poo-reveal bg-poo-black-rich border-t border-poo-gold-dark/40 py-16"
>
    <div class="mx-auto max-w-4xl px-4 text-center">
        <!-- Label -->
        <p class="font-cormorant text-poo-text-muted text-base sm:text-lg mb-2">
            Gala de Premiación el
        </p>
        <h2
            class="font-playfair text-poo-gold-light text-2xl sm:text-4xl font-bold mb-4"
        >
            29 de Mayo de 2026
        </h2>

        <!-- Event location -->
        <p class="font-cormorant text-poo-text-muted text-base sm:text-lg mb-10">
            18:00 horas — Hotel Edén, Oruro
        </p>

        <!-- Countdown blocks (AlpineJS) -->
        <div
            x-data="pooCountdown()"
            x-init="start()"
            class="flex flex-wrap justify-center gap-2 sm:gap-4"
        >
            <!-- Days -->
            <div
                class="bg-poo-black-card border border-poo-gold-dark/30 rounded px-3 py-3 sm:px-8 sm:py-6 min-w-[60px] sm:min-w-[80px]"
            >
                <span
                    x-text="days"
                    class="font-playfair text-3xl sm:text-5xl font-bold text-poo-gold-light block"
                    >00</span
                >
                <span
                    class="font-inter text-[0.65rem] sm:text-xs text-poo-text-muted tracking-[0.2em] uppercase mt-1 block"
                    >Días</span
                >
            </div>

            <span
                class="text-poo-wine-mid font-playfair text-2xl sm:text-4xl self-center hidden sm:block"
                >:</span
            >

            <!-- Hours -->
            <div
                class="bg-poo-black-card border border-poo-gold-dark/30 rounded px-3 py-3 sm:px-8 sm:py-6 min-w-[60px] sm:min-w-[80px]"
            >
                <span
                    x-text="hours"
                    class="font-playfair text-3xl sm:text-5xl font-bold text-poo-gold-light block"
                    >00</span
                >
                <span
                    class="font-inter text-[0.65rem] sm:text-xs text-poo-text-muted tracking-[0.2em] uppercase mt-1 block"
                    >Horas</span
                >
            </div>

            <span
                class="text-poo-wine-mid font-playfair text-2xl sm:text-4xl self-center hidden sm:block"
                >:</span
            >

            <!-- Minutes -->
            <div
                class="bg-poo-black-card border border-poo-gold-dark/30 rounded px-3 py-3 sm:px-8 sm:py-6 min-w-[60px] sm:min-w-[80px]"
            >
                <span
                    x-text="minutes"
                    class="font-playfair text-3xl sm:text-5xl font-bold text-poo-gold-light block"
                    >00</span
                >
                <span
                    class="font-inter text-[0.65rem] sm:text-xs text-poo-text-muted tracking-[0.2em] uppercase mt-1 block"
                    >Minutos</span
                >
            </div>

            <span
                class="text-poo-wine-mid font-playfair text-2xl sm:text-4xl self-center hidden sm:block"
                >:</span
            >

            <!-- Seconds -->
            <div
                class="bg-poo-black-card border border-poo-gold-dark/30 rounded px-3 py-3 sm:px-8 sm:py-6 min-w-[60px] sm:min-w-[80px]"
            >
                <span
                    x-text="seconds"
                    class="font-playfair text-3xl sm:text-5xl font-bold text-poo-gold-light block"
                    >00</span
                >
                <span
                    class="font-inter text-[0.65rem] sm:text-xs text-poo-text-muted tracking-[0.2em] uppercase mt-1 block"
                    >Segundos</span
                >
            </div>

            <!-- Expired message -->
            <div x-show="expired" x-cloak class="w-full mt-6">
                <p class="font-cormorant text-xl text-poo-gold-mid italic">
                    ¡La Gala de Premiación ha comenzado!
                </p>
            </div>
        </div>
    </div>
</section>

<script is:inline>
    function pooCountdown() {
        return {
            days: "00",
            hours: "00",
            minutes: "00",
            seconds: "00",
            expired: false,
            interval: null,

            // Target: May 29, 2026, 18:00:00 Bolivia time (UTC-4)
            target: new Date("2026-05-29T18:00:00-04:00").getTime(),

            start() {
                this.update();
                this.interval = setInterval(() => this.update(), 1000);
            },

            update() {
                const now = Date.now();
                const diff = this.target - now;

                if (diff <= 0) {
                    this.expired = true;
                    this.days = "00";
                    this.hours = "00";
                    this.minutes = "00";
                    this.seconds = "00";
                    if (this.interval) clearInterval(this.interval);
                    return;
                }

                this.expired = false;
                const d = Math.floor(diff / (1000 * 60 * 60 * 24));
                const h = Math.floor(
                    (diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60),
                );
                const m = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
                const s = Math.floor((diff % (1000 * 60)) / 1000);

                this.days = String(d).padStart(2, "0");
                this.hours = String(h).padStart(2, "0");
                this.minutes = String(m).padStart(2, "0");
                this.seconds = String(s).padStart(2, "0");
            },
        };
    }
</script>
