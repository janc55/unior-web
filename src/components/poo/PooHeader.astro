---
/* === COMPONENTE: PooHeader === */
---

<header
    class="sticky top-0 z-50 bg-poo-black-deep/90 backdrop-blur-md border-b border-poo-gold-dark/40"
>
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="flex h-16 items-center justify-between">
            <!-- Logo UNIOR -->
            <a href="/" class="flex items-center gap-2 group">
                <img
                    src="/assets/poo/unior_gala.webp"
                    alt="UNIOR"
                    class="h-10 sm:h-12 w-auto object-contain group-hover:brightness-110 transition-all duration-200"
                />
            </a>

            <!-- Centro -->
            <a
                href="https://www.unior.edu.bo"
                target="_blank"
                rel="noopener noreferrer"
                class="hidden md:block text-xs text-poo-text-muted hover:text-poo-gold-light transition-colors duration-200 tracking-wide"
            >
                www.unior.edu.bo
            </a>

            <!-- Fundación Sebastián Pagador -->
            <a href="#" class="flex items-center gap-2 group">
                <img
                    src="/assets/poo/fsp_gala.webp"
                    alt="Fundación Sebastián Pagador"
                    class="h-10 sm:h-12 w-auto object-contain group-hover:brightness-110 transition-all duration-200"
                />
            </a>
        </div>
    </div>
</header>
