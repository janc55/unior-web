---
// Hero Section Component
const videoPoster = "/unior-hero-poster.webp";  // ← crea esta imagen (ver abajo)
const dominantColor = "#2596be";
---

<section class="relative h-screen overflow-hidden" style={`background-color: ${dominantColor};`}>
  <div class="absolute inset-0 z-0">
    <div class="relative h-full w-full">
      <!-- Poster que aparece INMEDIATAMENTE -->
      <img 
        src={videoPoster}
        alt="Universidad Privada de Oruro"
        class="absolute inset-0 h-full w-full object-cover opacity-100 transition-opacity duration-1000"
        id="video-poster"
        loading="eager"
      />

      <!-- Video con poster real y fade-in -->
      <video 
        class="absolute inset-0 h-full w-full object-cover opacity-0 transition-opacity duration-1000"
        autoplay 
        loop 
        muted 
        playsinline
        preload="metadata"
        poster={videoPoster}
        id="hero-video"
      >
        <source src="/unior-hero.mp4" type="video/mp4" />
      </video>

      <div class="absolute inset-0 bg-black/30"></div>
      <div class="absolute inset-0 bg-primary/10 mix-blend-multiply"></div>
    </div>
  </div>

  <div class="relative z-10 flex h-full items-center justify-center px-4">
    <div class="text-center">
      <h1 class="mb-6 text-5xl font-bold text-white md:text-7xl">
        Universidad Privada de Oruro
      </h1>
      <p class="mb-8 text-xl text-white/90 md:text-2xl">
        Formando profesionales de excelencia para el futuro
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a 
          href="/admisiones" 
          class="rounded-full bg-primary px-8 py-3 text-lg font-semibold text-white transition hover:bg-primary-light/90"
        >
          Admisiones 2026
        </a>
        <a 
          href="/#carreras" 
          class="rounded-full border-2 border-primary-light bg-transparent px-8 py-3 text-lg font-semibold text-white transition hover:bg-primary-light hover:text-black"
        >
          Explorar Carreras
        </a>
      </div>
    </div>
  </div>
  <div class="absolute right-4 top-1/2 transform -translate-y-1/2 z-20 space-y-3 hidden md:flex flex-col">

    <div class="relative group floating-btn" data-delay="0">
        <a href="/carreras/administracion-empresas" class="flex items-center justify-center w-14 h-14 bg-white/10 backdrop-blur-sm border border-white/20 rounded-full text-white hover:bg-yellow-400 hover:text-[#a32323] transition-all duration-300 transform hover:scale-110 shadow-lg" aria-label="Administración de Empresas">
            <i class="fas fa-briefcase text-xl"></i>
        </a>
        <div class="tooltip absolute right-16 top-1/2 transform -translate-y-1/2 opacity-0 translate-x-2 pointer-events-none transition-all duration-300 group-hover:opacity-100 group-hover:translate-x-0 group-hover:pointer-events-auto">
            <div class="bg-yellow-400 text-[#a32323] px-4 py-2 rounded-lg font-semibold text-sm whitespace-nowrap shadow-lg">
                Administración de Empresas
                <div class="absolute left-full top-1/2 transform -translate-y-1/2 w-0 h-0 border-l-8 border-l-yellow-400 border-t-4 border-t-transparent border-b-4 border-b-transparent"></div>
            </div>
        </div>
    </div>

    <div class="relative group floating-btn" data-delay="0.1">
        <a href="/carreras/auditoria" class="flex items-center justify-center w-14 h-14 bg-white/10 backdrop-blur-sm border border-white/20 rounded-full text-white hover:bg-yellow-400 hover:text-[#a32323] transition-all duration-300 transform hover:scale-110 shadow-lg" aria-label="Auditoría">
            <i class="fas fa-calculator text-xl"></i>
        </a>
        <div class="tooltip absolute right-16 top-1/2 transform -translate-y-1/2 opacity-0 translate-x-2 pointer-events-none transition-all duration-300 group-hover:opacity-100 group-hover:translate-x-0 group-hover:pointer-events-auto">
            <div class="bg-yellow-400 text-[#a32323] px-4 py-2 rounded-lg font-semibold text-sm whitespace-nowrap shadow-lg">
                Auditoría
                <div class="absolute left-full top-1/2 transform -translate-y-1/2 w-0 h-0 border-l-8 border-l-yellow-400 border-t-4 border-t-transparent border-b-4 border-b-transparent"></div>
            </div>
        </div>
    </div>

    <div class="relative group floating-btn" data-delay="0.2">
        <a href="/carreras/ingenieria-de-sistemas" class="flex items-center justify-center w-14 h-14 bg-white/10 backdrop-blur-sm border border-white/20 rounded-full text-white hover:bg-yellow-400 hover:text-[#a32323] transition-all duration-300 transform hover:scale-110 shadow-lg" aria-label="Ingeniería de Sistemas">
            <i class="fas fa-laptop-code text-xl"></i>
        </a>
        <div class="tooltip absolute right-16 top-1/2 transform -translate-y-1/2 opacity-0 translate-x-2 pointer-events-none transition-all duration-300 group-hover:opacity-100 group-hover:translate-x-0 group-hover:pointer-events-auto">
            <div class="bg-yellow-400 text-[#a32323] px-4 py-2 rounded-lg font-semibold text-sm whitespace-nowrap shadow-lg">
                Ing. de Sistemas
                <div class="absolute left-full top-1/2 transform -translate-y-1/2 w-0 h-0 border-l-8 border-l-yellow-400 border-t-4 border-t-transparent border-b-4 border-b-transparent"></div>
            </div>
        </div>
    </div>

    <div class="relative group floating-btn" data-delay="0.3">
        <a href="/carreras/gastronomia-turismo-hoteleria" class="flex items-center justify-center w-14 h-14 bg-white/10 backdrop-blur-sm border border-white/20 rounded-full text-white hover:bg-yellow-400 hover:text-[#a32323] transition-all duration-300 transform hover:scale-110 shadow-lg" aria-label="Gastronomía, Turismo y Hotelería">
            <i class="fas fa-utensils text-xl"></i>
        </a>
        <div class="tooltip absolute right-16 top-1/2 transform -translate-y-1/2 opacity-0 translate-x-2 pointer-events-none transition-all duration-300 group-hover:opacity-100 group-hover:translate-x-0 group-hover:pointer-events-auto">
            <div class="bg-yellow-400 text-[#a32323] px-4 py-2 rounded-lg font-semibold text-sm whitespace-nowrap shadow-lg">
                Gastronomía, Turismo y Hotelería
                <div class="absolute left-full top-1/2 transform -translate-y-1/2 w-0 h-0 border-l-8 border-l-yellow-400 border-t-4 border-t-transparent border-b-4 border-b-transparent"></div>
            </div>
        </div>
    </div>

    <div class="relative group floating-btn" data-delay="0.4">
        <a href="/carreras/derecho" class="flex items-center justify-center w-14 h-14 bg-white/10 backdrop-blur-sm border border-white/20 rounded-full text-white hover:bg-yellow-400 hover:text-[#a32323] transition-all duration-300 transform hover:scale-110 shadow-lg" aria-label="Derecho">
            <i class="fas fa-gavel text-xl"></i>
        </a>
        <div class="tooltip absolute right-16 top-1/2 transform -translate-y-1/2 opacity-0 translate-x-2 pointer-events-none transition-all duration-300 group-hover:opacity-100 group-hover:translate-x-0 group-hover:pointer-events-auto">
            <div class="bg-yellow-400 text-[#a32323] px-4 py-2 rounded-lg font-semibold text-sm whitespace-nowrap shadow-lg">
                Derecho
                <div class="absolute left-full top-1/2 transform -translate-y-1/2 w-0 h-0 border-l-8 border-l-yellow-400 border-t-4 border-t-transparent border-b-4 border-b-transparent"></div>
            </div>
        </div>
    </div>

    <div class="relative group floating-btn" data-delay="0.5">
        <a href="/carreras/odontologia" class="flex items-center justify-center w-14 h-14 bg-white/10 backdrop-blur-sm border border-white/20 rounded-full text-white hover:bg-yellow-400 hover:text-[#a32323] transition-all duration-300 transform hover:scale-110 shadow-lg" aria-label="Odontología">
            <i class="fas fa-tooth text-xl"></i>
        </a>
        <div class="tooltip absolute right-16 top-1/2 transform -translate-y-1/2 opacity-0 translate-x-2 pointer-events-none transition-all duration-300 group-hover:opacity-100 group-hover:translate-x-0 group-hover:pointer-events-auto">
            <div class="bg-yellow-400 text-[#a32323] px-4 py-2 rounded-lg font-semibold text-sm whitespace-nowrap shadow-lg">
                Odontología
                <div class="absolute left-full top-1/2 transform -translate-y-1/2 w-0 h-0 border-l-8 border-l-yellow-400 border-t-4 border-t-transparent border-b-4 border-b-transparent"></div>
            </div>
        </div>
    </div>

    <div class="relative group floating-btn" data-delay="0.6">
        <a href="/carreras/medicina" class="flex items-center justify-center w-14 h-14 bg-white/10 backdrop-blur-sm border border-white/20 rounded-full text-white hover:bg-yellow-400 hover:text-[#a32323] transition-all duration-300 transform hover:scale-110 shadow-lg" aria-label="Medicina">
            <i class="fas fa-heartbeat text-xl"></i>
        </a>
        <div class="tooltip absolute right-16 top-1/2 transform -translate-y-1/2 opacity-0 translate-x-2 pointer-events-none transition-all duration-300 group-hover:opacity-100 group-hover:translate-x-0 group-hover:pointer-events-auto">
            <div class="bg-yellow-400 text-[#a32323] px-4 py-2 rounded-lg font-semibold text-sm whitespace-nowrap shadow-lg">
                Medicina
                <div class="absolute left-full top-1/2 transform -translate-y-1/2 w-0 h-0 border-l-8 border-l-yellow-400 border-t-4 border-t-transparent border-b-4 border-b-transparent"></div>
            </div>
        </div>
    </div>

    <div class="relative group floating-btn" data-delay="0.7">
        <a href="/carreras/enfermeria" class="flex items-center justify-center w-14 h-14 bg-white/10 backdrop-blur-sm border border-white/20 rounded-full text-white hover:bg-yellow-400 hover:text-[#a32323] transition-all duration-300 transform hover:scale-110 shadow-lg" aria-label="Enfermería">
            <i class="fas fa-user-nurse text-xl"></i>
        </a>
        <div class="tooltip absolute right-16 top-1/2 transform -translate-y-1/2 opacity-0 translate-x-2 pointer-events-none transition-all duration-300 group-hover:opacity-100 group-hover:translate-x-0 group-hover:pointer-events-auto">
            <div class="bg-yellow-400 text-[#a32323] px-4 py-2 rounded-lg font-semibold text-sm whitespace-nowrap shadow-lg">
                Enfermería
                <div class="absolute left-full top-1/2 transform -translate-y-1/2 w-0 h-0 border-l-8 border-l-yellow-400 border-t-4 border-t-transparent border-b-4 border-b-transparent"></div>
            </div>
        </div>
    </div>

  </div>
</section>

<style>
  /* Animaciones personalizadas para Tailwind CSS */
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes scaleIn {
    from {
      opacity: 0;
      transform: scale(0.95);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @keyframes pulseSlow {
    0%, 100% {
      opacity: 0.2;
      transform: scale(1);
    }
    50% {
      opacity: 0.4;
      transform: scale(1.03);
    }
  }

  @keyframes slideInRight {
    from {
      opacity: 0;
      transform: translateX(50px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  .animate-fade-in-up {
    animation: fadeInUp 0.8s ease-out forwards;
    opacity: 0;
  }

  .animate-scale-in {
    animation: scaleIn 0.7s ease-out forwards;
    opacity: 0;
  }

  .animate-pulse-slow {
    animation: pulseSlow 4s infinite ease-in-out;
  }

  .floating-btn {
    animation: slideInRight 0.6s ease-out forwards;
    opacity: 0;
  }

  /* Retrasos para las animaciones */
  .animation-delay-0-5s {
    animation-delay: 0.3s;
  }
  .animation-delay-1s {
    animation-delay: 0.6s;
  }
  .animation-delay-1-5s {
    animation-delay: 0.9s;
  }
  .animation-delay-2s {
    animation-delay: 1.2s;
  }

  /* Responsive adjustments (hidden by default on small screens) */
  @media (max-width: 767px) { /* Tailwind's 'md' breakpoint is 768px, so hidden for <md */
    .floating-btn {
      display: none !important; /* Use !important if Tailwind's flex is overriding */
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // ==================== 1. Vídeo hero con poster y fade-in ====================
    const video = document.getElementById('hero-video');
    const poster = document.getElementById('video-poster');

    if (video && poster) {
      // Cuando el vídeo ya tiene el primer frame listo → fade-in del vídeo y fade-out del poster
      const showVideo = () => {
        video.classList.remove('opacity-0');
        video.classList.add('opacity-100');
        poster.classList.remove('opacity-100');
        poster.classList.add('opacity-0');
      };

      // Eventos que garantizan que se muestre lo más rápido posible
      video.addEventListener('canplay', showVideo);
      video.addEventListener('canplaythrough', showVideo);
      video.addEventListener('loadedmetadata', () => {
        // En algunos navegadores el primer frame ya está listo aquí
        if (video.readyState >= 2) showVideo();
      });

      // Fallback por si el vídeo nunca dispara los eventos (red lenta, adblock, etc.)
        video.addEventListener('error', () => {
        poster.classList.add('opacity-100'); // al menos se ve el poster bonito
      });

      // Forzamos preload y reproducción inmediata
      video.load();
    }

    // ==================== 2. Animación retardada de los botones flotantes ====================
    const floatingBtns = document.querySelectorAll<HTMLElement>('.floating-btn');

    floatingBtns.forEach((btn) => {
      const delay = parseFloat(btn.dataset.delay || '0');
      // Sumamos 1 segundo extra para que aparezcan después del hero cargado
      btn.style.animationDelay = `${delay + 1}s`;
    });
  });
</script>
