---
// src/pages/congreso.astro
import Layout from "../../layouts/Layout.astro";
---

<Layout title="I Congreso Nacional de Gastronomía y Alta Cocina - Evento Finalizado">
  <html lang="es">
    <head>
      <meta charset="utf-8" />
      <link rel="preconnect" href="https://fonts.googleapis.com">
      <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
      <link href="https://fonts.googleapis.com/css2?family=Exo+2:wght@300;400;600;700;800&family=Sofia+Sans:wght@300;400;500;700&family=Sofia&display=swap" rel="stylesheet">
      
      <style>
        :root {
          --primary-color: #5d1a1f;
          --secondary-color: #8a2a30;
          --accent-color: #c9a37e;
          --text-dark: #222222;
          --text-light: #555555;
          --bg-light: #f5f5f5;
        }
        body {
          font-family: 'Sofia Sans', sans-serif;
          color: var(--text-dark);
        }
        h1, h2, h3 {
          font-family: 'Exo 2', sans-serif;
        }
        .font-sofia-decorative {
          font-family: 'Sofia', cursive;
          font-weight: 400;
        }
      </style>
    </head>
    
    <body class="bg-white text-[var(--text-dark)] antialiased">
      <!-- Hero simplificado -->
      <section class="relative min-h-[70vh] flex items-center overflow-hidden" style="background: linear-gradient(135deg, #c9a37e 0%, #f5f5dc 50%, #faf0e6 100%);">
        <div class="absolute inset-0 opacity-10 bg-repeat" style="background-image: url('/congreso/pattern-bg.png'); background-size: auto; background-repeat: repeat;"></div>
        
        <div class="container mx-auto px-6 py-24 text-center relative z-10">
          <div class="w-64 h-64 mx-auto mb-8 flex items-center justify-center">
            <img src="/congreso/logo-congreso.png" alt="Logo Congreso" class="w-full h-full object-contain object-center" />
          </div>
          
          <div class="mb-8">
            <h1 class="text-4xl md:text-5xl font-bold mb-4 text-[var(--primary-color)]">Evento Finalizado</h1>
            <p class="text-xl md:text-2xl font-light text-[var(--secondary-color)]">El I Congreso Nacional de Gastronomía y Alta Cocina ha concluido</p>
          </div>
          
          <div class="flex flex-col md:flex-row justify-center items-center space-y-4 md:space-y-0 md:space-x-8 mb-12">
            <p class="text-xl md:text-2xl font-semibold" style="color: #95323b;">14 y 15 de Noviembre de 2025</p>
            <img src="/congreso/forma1.svg" alt="" class="hidden md:inline-block w-1.5 h-16 mx-2 opacity-70" style="filter: brightness(0.4) sepia(1) saturate(5) hue-rotate(340deg);" />
            <p class="text-lg md:text-xl font-light" style="color: #712428;">Casa de la Cultura, Oruro, Bolivia</p>
          </div>
          
          <div class="flex flex-col md:flex-row justify-center gap-6">
            <a href="https://www.tiktok.com/@unior_oruro/video/7574643237646880011" target="_blank" class="bg-[var(--accent-color)] text-[var(--primary-color)] px-8 py-4 rounded-full font-bold text-lg uppercase shadow-lg hover:bg-opacity-90 transition duration-300 transform hover:-translate-y-1 inline-block border-2 border-[var(--accent-color)] hover:border-opacity-80">
              Ver Videos del Evento
            </a>
          </div>
        </div>
      </section>
      <!-- Footer (mantenido igual) -->
      <footer class="py-16 bg-[var(--primary-color)] text-white">
        <div class="container mx-auto px-6">
          <div class="grid grid-cols-1 md:grid-cols-3 gap-12 mb-12">
            <div class="text-center md:text-left">
              <h3 class="text-2xl font-bold mb-6 text-[var(--accent-color)]">Contacto</h3>
              <ul class="space-y-3 text-lg font-light">
                <li>
                  <a href="mailto:comitecientificounior@gmail.com" class="hover:text-[var(--accent-color)] transition duration-300 block">comitecientificounior@gmail.com</a>
                </li>
                <li>
                  <a href="https://wa.me/59174148884" class="hover:text-[var(--accent-color)] transition duration-300 block" target="_blank">+ 591 74148884</a>
                </li>
              </ul>
            </div>
            
            <div class="text-center">
              <h3 class="text-2xl font-bold mb-6 text-[var(--accent-color)]">Organizador</h3>
              <p class="text-lg">Universidad Privada de Oruro <br> Carrera de Gastronomía, Turismo y Hotelería</p>
            </div>
            
            <div class="text-center md:text-right">
              <h3 class="text-2xl font-bold mb-6 text-[var(--accent-color)]">Enlaces</h3>
              <ul class="space-y-3 text-lg font-light">
                <li>
                  <a href="https://www.unior.edu.bo" class="hover:text-[var(--accent-color)] transition duration-300 block" target="_blank">Sitio Web UNIOR</a>
                </li>
              </ul>
            </div>
          </div>
          
          <div class="border-t border-white/20 pt-8 flex flex-col md:flex-row justify-between items-center text-center md:text-left">
            <div class="flex items-center space-x-4 mb-4 md:mb-0">
              <img src="/logo-unior-white.webp" alt="UNIOR" class="h-16 w-auto" />
            </div>
            <p class="text-sm opacity-80">&copy; 2025 I Congreso Nacional de Gastronomía y Alta Cocina. Evento finalizado.</p>
          </div>
        </div>
      </footer>
      
      <!-- Barra de créditos desarrollador -->
      <div class="bg-[#4a1519] text-white py-6">
        <div class="container mx-auto px-6 text-center">
          <p class="text-lg">Desarrollado por <a href="#" class="underline hover:text-[var(--accent-color)] transition duration-300">NettiDev</a></p>
        </div>
      </div>
    </body>
  </html>
</Layout>